{
  "manifest_version": 3,
  "name": "TaskFlow Pro",
  "key": "",
  "version": "2.19.0",
  "description": "TaskFlow Pro v2 — مهام + مشاريع + تقويم + أهداف + بومودورو + حساب سحابي",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["ai-providers.js", "chat-float.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "tasbih-tap": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      },
      "description": "📿 دوسة تسبيح: زيادة عدّاد الذكر اليومي"
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "identity"
  ],
  "host_permissions": [
    "https://identitytoolkit.googleapis.com/*",
    "https://securetoken.googleapis.com/*",
    "https://firestore.googleapis.com/*",
    "https://api.aladhan.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.groq.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
